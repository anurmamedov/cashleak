<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sign in with Apple. The welcome screen's primary button; without this
	     the ASAuthorizationController fails at runtime rather than at build. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>

	<!-- CloudKit. The container is the user's own private database; there is no
	     public or shared zone, and no server of ours anywhere in the path. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.anar.cashleak</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>

	<!-- Push. Not for messaging — CloudKit uses silent notifications to tell the
	     device a change landed. Without it sync only pulls on launch. -->
	<key>aps-environment</key>
	<string>development</string>

	<!-- Shared container so the widget can read the same SwiftData store. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.anar.cashleak</string>
	</array>
</dict>
</plist>
